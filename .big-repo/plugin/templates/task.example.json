{
  "objective": "替换为实际维护任务",
  "base_sha": "0000000000000000000000000000000000000000",
  "allowed_paths": [
    "README.md",
    "docs/**"
  ],
  "allowed_actions": [
    "commit",
    "push",
    "create-pr",
    "merge"
  ],
  "validation": [
    {
      "id": "docs",
      "command": "替换为实际内容与链接检查命令"
    }
  ],
  "done_when": [
    "修改符合目标",
    "验证与独立 AI 审查通过，阻塞发现已修复并复审",
    "登记的CI和其他可见检查全部成功",
    "最终head SHA锁定后PR已合并"
  ],
  "merge": {
    "repository": "owner/repository",
    "base_branch": "main",
    "required_checks": [
      "CI_CHECK_NAME"
    ]
  }
}
